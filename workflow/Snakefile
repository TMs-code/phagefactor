PROPHAGES = list(PF.PROPHAGE_NAMES)
if INPUT_MODE == "genome" and not PROPHAGES:
    raise WorkflowError(f"genome mode: {INPUT_DIR / 'prophage_list.txt'} is missing or empty")

if INPUT_MODE == "pangenome":
    _nt = setting("pangenome_nt_fasta", "PANGENOME_NT_FASTA", "")
    if not _nt:
        for d in (INPUT_DIR / "pangenome_nt", Path(PF.FASTA_DIR)):
            hits = sorted(f for ext in ("*.fa", "*.fna", "*.fasta") for f in d.glob(ext)) if d.is_dir() else []
            if hits:
                _nt = str(hits[0])
                break
    if not _nt or not Path(_nt).is_file():
        raise WorkflowError("pangenome mode: no nucleotide FASTA found (set pangenome_nt_fasta)")
    PANG_NT = _abs(_nt)
    PANG_FAA = P(PANG_DIR / "fasta" / (Path(PANG_NT).stem + "_proteins.faa"))
    PROTEIN_FASTA_DIR = str(PANG_DIR / "fasta")
    os.environ["PANGENOME_ID_MAP"] = PANG_ID_MAP
else:
    PROTEIN_FASTA_DIR = os.environ.get("PROTEIN_FASTA_DIR") or str(PF.FASTA_DIR)


def protein_inputs():
    if INPUT_MODE == "pangenome":
        return [PANG_FAA]
    d = Path(PROTEIN_FASTA_DIR)
    return sorted(str(p) for p in d.iterdir()
                  if p.is_file() and p.suffix.lower() in (".faa", ".fa", ".fasta"))


def final_targets():
    t = [FINAL_TABLE, REPORT]
    if RUN_PHYNTENY:
        t.append(PHYNTENY_DONE)
    if INPUT_MODE == "pangenome":
        t.append(PANG_REF)
    return t


# -----------------------------------------------------------------------------
# Preflight: the tools and databases of the steps that still have work to do.
# Runs once in the main process (also with -n), never inside a cluster job.
# Skip with --config preflight=false.
# -----------------------------------------------------------------------------
def _missing_tools(tools):
    if not tools:
        return []
    if not os.environ["PF_TOOLS"]:
        return [t for t in tools if not shutil.which(t)]
    probe = "for t in " + " ".join(tools) + "; do command -v $t >/dev/null || echo $t; done"
    r = subprocess.run(os.environ["PF_TOOLS"].split() + ["sh", "-c", probe],
                       capture_output=True, text=True, timeout=300)
    if r.returncode != 0:
        return [f"(environment unusable: {r.stderr.strip().splitlines()[-1] if r.stderr.strip() else r.returncode})"]
    return r.stdout.split()


def preflight():
    pending = lambda marker: not Path(RUN_DIR, marker).exists()
    tools, problems = [], []
    if INPUT_MODE == "genome":
        if any(pending(Path(PF.PHAROKKA_OUT_DIR) / p / ".pharokka_done") for p in PROPHAGES):
            tools.append("pharokka.py")
            if not Path(PF.PHAROKKA_DB).is_dir():
                problems.append(f"pharokka database not found: {PF.PHAROKKA_DB}")
        if any(pending(Path(PF.PHOLD_OUT_DIR) / p / ".phold_done") for p in PROPHAGES):
            tools.append("phold")
    elif pending(PF.PHOLD_COMBINED_TSV):
        tools.append("phold")
    # without phold_db/, phold looks in its own env: empty in an env --sdm conda builds
    if USE_CONDA and "phold" in tools and PHOLD_MODE != "remote" and not Path(PF.PHOLD_DB).is_dir():
        problems.append(f"phold database not found: {PF.PHOLD_DB} (with --sdm conda phold "
                        "cannot use a database installed inside another env: "
                        "phagefactor databases --phold, or databases.phold_db in config.yaml)")
    if SEARCH_MODE == "local" and pending(PER_DB_DIR):
        tools.append("foldseek")
        dbs = {n: d for n, d in PF.FOLDSEEK_LOCAL_DBS.items() if not FOLDSEEK_DBS or n in FOLDSEEK_DBS}
        if not any(Path(str(d) + ".dbtype").is_file() for d in dbs.values()):
            problems.append("no FoldSeek database found: " + ", ".join(str(d) for d in dbs.values()))
    # --sdm conda: the envs are built after this check, the tools come with them
    miss = [] if USE_CONDA else _missing_tools(tools)
    if miss:
        problems.append(f"not found in tool environment '{TOOLS_LABEL}': {' '.join(miss)}")
    if problems:
        raise WorkflowError(
            "preflight failed:\n  - " + "\n  - ".join(problems) +
            f"\n  database root: {PF.DB_ROOT}"
            f"\n  settings: {PF.CONFIG_FILE}; user settings: {USER_SETTINGS}"
            f"{'' if USER_SETTINGS.is_file() else ' (missing)'}"
            "\n  Set db_root / tools_env there (docs/configure.md), or skip this check "
            "with --config preflight=false.")


if not os.environ.get("SLURM_JOB_ID") and setting("preflight", None, True, bool):
    preflight()


# Early abort for per-prophage / per-batch jobs: once FAIL_LIMIT jobs of a rule
# have failed and none has succeeded, the remaining ones exit at once.
FAIL_LIMIT = 5
FAIL_DIR = f"{LOGS}/.failures"


def guarded(rule_name, key, body):
    """Shell for one array job: skip when the rule is failing everywhere,
    record the outcome otherwise."""
    d = f"{FAIL_DIR}/{rule_name}"
    return (
        f"mkdir -p {d}; "
        f"nf=$(ls {d} | grep -c '\\.fail$' || true); ns=$(ls {d} | grep -c '\\.ok$' || true); "
        f"if [ $nf -ge {FAIL_LIMIT} ] && [ $ns -eq 0 ]; then "
        f"echo \"skipped: $nf {rule_name} jobs failed and none succeeded; see their logs in {LOGS}/{rule_name}/\" "
        f"| tee {{log}} >&2; "
        f"exit 1; fi; "
        f"if {body}; then touch {d}/{key}.ok; else touch {d}/{key}.fail; exit 1; fi"
    )


# At launch, in the main process (never in a cluster job). Not an `onstart:`
# handler: Snakemake ignores those of a module, and stale failure records
# would then skip every job of a rule that failed in an earlier run.
if not os.environ.get("SLURM_JOB_ID"):
    shutil.rmtree(FAIL_DIR, ignore_errors=True)
    print(f"[phageFACTor] project: {PROJECT}", file=sys.stderr)
    print(f"[phageFACTor] input : {INPUT_DIR}", file=sys.stderr)
    print(f"[phageFACTor] run   : {RUN_DIR}", file=sys.stderr)
    print(f"[phageFACTor] mode  : {INPUT_MODE}   search: {SEARCH_MODE}   "
          f"env: {TOOLS_LABEL}", file=sys.stderr)
    if RUN_PHYNTENY:
        print(f"[phageFACTor] PHYNTENY: ON (default) -> {PHYNTENY_DIR}/final_annotations_integrated.csv"
              f"   (skip with --config phynteny=false)", file=sys.stderr)
    else:
        print("[phageFACTor] PHYNTENY: OFF", file=sys.stderr)


onsuccess:
    if Path(REPORT).is_file():
        print(f"[phageFACTor] REPORT: {REPORT}  (open in a browser)", file=sys.stderr)
    if RUN_PHYNTENY:
        _log = Path(LOGS) / "phynteny.log"
        _txt = _log.read_text(errors="ignore") if _log.is_file() else ""
        if "[SKIP]" in _txt:
            _why = [l for l in _txt.splitlines() if "[SKIP]" in l][0]
            print(f"[phageFACTor] PHYNTENY WAS SKIPPED: {_why}", file=sys.stderr)
        elif (PHYNTENY_DIR / "final_annotations_integrated.csv").is_file():
            print(f"[phageFACTor] PHYNTENY RAN: {PHYNTENY_DIR}/final_annotations_integrated.csv "
                  f"(final table + phynteny categories + synteny hints)", file=sys.stderr)


# =============================================================================
# Target
# =============================================================================
rule all:
    localrule: True
    input: final_targets()


# =============================================================================
# GENOME MODE: pharokka -> phold (one job per prophage) -> merge
# =============================================================================
rule pharokka:
    input:
        fasta = str(Path(PF.FASTA_DIR) / "{prophage}.fasta"),
    output:
        gbk  = str(Path(PF.PHAROKKA_OUT_DIR) / "{prophage}" / "{prophage}.gbk"),
        done = str(Path(PF.PHAROKKA_OUT_DIR) / "{prophage}" / ".pharokka_done"),
    threads: threads_of("pharokka")
    resources: **res("pharokka")
    conda: TOOLS_CONDA
    log: f"{LOGS}/pharokka/{{prophage}}.log"
    shell:
        # default gene caller Phanotate (not --fast/pyrodigal-gv): more small phage ORFs
        guarded("pharokka", "{wildcards.prophage}",
            "( t=${{SCRATCH_TMPDIR:-${{TMPDIR:-/tmp}}}}; mkdir -p $t; export TMPDIR=$(mktemp -d $t/pf_pharokka.XXXXXX); "
            "  trap 'rm -rf $TMPDIR' EXIT; "
            "  test -d $PF_PHAROKKA_DB || {{ echo \"pharokka database not found: $PF_PHAROKKA_DB "
            "(phagefactor databases --pharokka, or databases.pharokka_db in config.yaml)\"; exit 1; }}; "
            # headers reduced to the sequence id, ':' -> '_' (phold rejects colons in the GenBank)
            "  sed -E '/^>/{{s/[[:space:]].*//; s/:/_/g}}' {input.fasta} > $TMPDIR/input.fasta; "
            "  $PF_TOOLS pharokka.py -i $TMPDIR/input.fasta -o $(dirname {output.gbk}) -d $PF_PHAROKKA_DB "
            "    -t {threads} -p {wildcards.prophage} -f "
            ") > {log} 2>&1 && test -s {output.gbk}") + "; touch {output.done}"


rule phold:
    input:
        gbk = rules.pharokka.output.gbk,
    output:
        done = str(Path(PF.PHOLD_OUT_DIR) / "{prophage}" / ".phold_done"),
    threads: threads_of("phold")
    resources: **res("phold", gpu=PHOLD_GPU)
    conda: TOOLS_CONDA
    log: f"{LOGS}/phold/{{prophage}}.log"
    shell:
        # $PF_PHOLD_CMD: run | remote; $PF_PHOLD_ARGS: --cpu | --foldseek_gpu --autotune;
        # $PF_PHOLD_DB: -d <db_root>/phold_db when that folder exists
        guarded("phold", "{wildcards.prophage}",
            "( t=${{SCRATCH_TMPDIR:-${{TMPDIR:-/tmp}}}}; mkdir -p $t; export TMPDIR=$(mktemp -d $t/pf_phold.XXXXXX); "
            "  trap 'rm -rf $TMPDIR' EXIT; "
            "  $PF_TOOLS phold $PF_PHOLD_CMD -i {input.gbk} -o $(dirname {output.done}) -t {threads} "
            "    --prefix {wildcards.prophage} -f $PF_PHOLD_ARGS $PF_PHOLD_DB "
            ") > {log} 2>&1") + "; touch {output.done}"


if INPUT_MODE == "genome":
    rule phold_merge:
        input:
            expand(rules.phold.output.done, prophage=PROPHAGES),
        output:
            COMBINED,
        threads: threads_of("phold_merge")
        resources: **res("phold_merge")
        conda: TOOLS_CONDA
        log: f"{LOGS}/phold_merge.log"
        shell:
            "$PF_TOOLS python3 $PHAGEFACTOR_HOME/scripts/01c_merge_phold.py > {log} 2>&1"


# =============================================================================
# PROTEIN / PANGENOME MODE: [translate] -> split -> phold per batch -> merge
# =============================================================================
if INPUT_MODE == "pangenome":
    rule pangenome_translate:
        input:
            nt = PANG_NT,
        output:
            faa    = PANG_FAA,
            id_map = PANG_ID_MAP,
        params:
            table  = setting("pangenome_table", "PANGENOME_TABLE", 11, int),
            prefix = setting("pangenome_prefix", "PANGENOME_PREFIX", "pang_"),
        conda: TOOLS_CONDA
        log: f"{LOGS}/pangenome_translate.log"
        shell:
            "$PF_TOOLS python3 $PHAGEFACTOR_HOME/scripts/00n_translate_pangenome.py "
            "--in {input.nt} --out-faa {output.faa} --id-map {output.id_map} "
            "--table {params.table} --prefix {params.prefix} --no-input-type > {log} 2>&1"


if PROTEIN_LIKE:
    checkpoint split_proteins:
        input:
            protein_inputs(),
        output:
            batch_list = BATCH_LIST,
            combined   = PROT_COMBINED_FAA,
        params:
            batch_size = BATCH_SIZE,
            fasta_dir  = PROTEIN_FASTA_DIR,
        threads: 1
        resources: **res("split_proteins")
        conda: TOOLS_CONDA
        log: f"{LOGS}/split_proteins.log"
        shell:
            # Snakemake removed the batch list, so 00p always re-splits (its own
            # "already up to date" shortcut only compares batch COUNTS).
            "PROTEIN_BATCH_SIZE={params.batch_size} PROTEIN_FASTA_DIR={params.fasta_dir} "
            "$PF_TOOLS python3 $PHAGEFACTOR_HOME/scripts/00p_split_protein_batches.py > {log} 2>&1"

    rule phold_proteins:
        input:
            # NOT the batch list: its content changes whenever the batch COUNT
            # changes, which would re-run every batch. A batch re-runs only when
            # its own FASTA changes.
            faa = str(BATCH_DIR / "{batch}.faa"),
        output:
            done = str(Path(PF.PHOLD_OUT_DIR) / "proteins" / "batches" / "{batch}" / ".batch_done"),
        params:
            bdir = str(Path(PF.PHOLD_OUT_DIR) / "proteins" / "batches" / "{batch}"),
        threads: threads_of("phold_proteins")
        resources: **res("phold_proteins", gpu=PHOLDP_GPU)
        conda: TOOLS_CONDA
        log: f"{LOGS}/phold_proteins/{{batch}}.log"
        shell:
            # proteins-predict (ProstT5 -> 3Di) then proteins-compare. GPU only when
            # requested AND visible to torch; --autotune is GPU-only.
            guarded("phold_proteins", "{wildcards.batch}",
            "( t=${{SCRATCH_TMPDIR:-${{TMPDIR:-/tmp}}}}; mkdir -p $t; export TMPDIR=$(mktemp -d $t/pf_pholdp.XXXXXX); "
            "  trap 'rm -rf $TMPDIR' EXIT; "
            "  gpu=$PF_PHOLDP_GPU; "
            "  if [ $gpu = 1 ] && ! $PF_TOOLS python3 -c 'import sys, torch; "
            "sys.exit(not torch.cuda.is_available())' 2>/dev/null; then "
            "    echo 'GPU requested but not visible to torch: CPU'; gpu=0; fi; "
            "  if [ $gpu = 1 ]; then pred='--autotune'; else pred='--batch_size 1 --cpu'; fi; "
            "  if [ $PF_PHOLDP_GPU = 1 ]; then comp='--foldseek_gpu'; else comp=''; fi; "
            "  $PF_TOOLS phold proteins-predict -i {input.faa} -o {params.bdir}/predictions "
            "    -t {threads} $pred -f $PF_PHOLD_DB; "
            "  $PF_TOOLS phold proteins-compare -i {input.faa} "
            "    --predictions_dir {params.bdir}/predictions -o {params.bdir}/compare "
            "    -t {threads} $comp -f $PF_PHOLD_DB "
            ") > {log} 2>&1") + "; touch {output.done}"

    def all_batch_markers(wildcards):
        bl = checkpoints.split_proteins.get().output.batch_list
        names = [l.strip() for l in open(bl) if l.strip()]
        return expand(rules.phold_proteins.output.done, batch=names)

    rule phold_proteins_merge:
        input:
            all_batch_markers,
        output:
            COMBINED,
        threads: threads_of("phold_proteins_merge")
        resources: **res("phold_proteins_merge")
        conda: TOOLS_CONDA
        log: f"{LOGS}/phold_proteins_merge.log"
        shell:
            "$PF_TOOLS python3 $PHAGEFACTOR_HOME/scripts/01p_merge_phold_proteins.py > {log} 2>&1"


# =============================================================================
# STEP 02 — custom FoldSeek: targets -> search -> parse
# =============================================================================
rule foldseek_targets:
    # gene_metadata.csv + targets/hypothetical_genes.csv. Built from the pharokka
    # annotation in genome mode, from phold in protein mode (02d logic).
    input:
        COMBINED,
        pharokka = expand(rules.pharokka.output.done, prophage=PROPHAGES)
                   if INPUT_MODE == "genome" else [],
    output:
        targets = TARGETS_CSV,
        meta    = GENE_META,
    threads: threads_of("foldseek_targets")
    resources: **res("foldseek_targets")
    conda: TOOLS_CONDA
    log: f"{LOGS}/foldseek_targets.log"
    shell:
        "$PF_TOOLS python3 $PHAGEFACTOR_HOME/scripts/02d_foldseek_3di.py --targets_only > {log} 2>&1"


if SEARCH_MODE == "local":
    rule foldseek_search:
        input:
            COMBINED,
            targets = TARGETS_CSV,
        output:
            directory(PER_DB_DIR),
        params:
            cfg = PARAMS_SEARCH,
            dbs = ("--dbs " + " ".join(FOLDSEEK_DBS)) if FOLDSEEK_DBS else "",
            qdir = P(FS3DI / "query_fastas"),
            qdb  = P(FS3DI / "query_db"),
        threads: threads_of("foldseek_search")
        resources: **res("foldseek_search", qos=QOS_LONG)
        conda: TOOLS_CONDA
        log: f"{LOGS}/foldseek_search.log"
        shell:
            # fresh query FASTAs/DB: their reuse check only compares counts
            "rm -rf {params.qdir} {params.qdb}; "
            "export TMPDIR=${{SCRATCH_TMPDIR:-${{TMPDIR:-/tmp}}}}; mkdir -p $TMPDIR; "
            "$PF_TOOLS python3 $PHAGEFACTOR_HOME/scripts/02d_foldseek_3di.py --search_only "
            "--threads {threads} {params.dbs} > {log} 2>&1"

    rule foldseek_parse:
        input:
            PER_DB_DIR,
            targets = TARGETS_CSV,
            meta = GENE_META,
            code = code("02d_foldseek_3di.py", "lib/foldseek_scoring.py", "lib/rules.py",
                        "lib/lexicon.py", "lib/utils.py", "lib/taxonomy.py"),
        output:
            best = BEST_HIT,
            top3 = TOP3,
        params:
            cfg = PARAMS_PARSE,
            raw = P(FS3DI / "raw_hits"),
        threads: threads_of("foldseek_parse")
        resources: **res("foldseek_parse")
        conda: TOOLS_CONDA
        log: f"{LOGS}/foldseek_parse.log"
        shell:
            # per-gene m8 files are a cache keyed on existence only: rebuild them
            "rm -rf {params.raw}; "
            "$PF_TOOLS python3 $PHAGEFACTOR_HOME/scripts/02d_foldseek_3di.py --parse_only > {log} 2>&1"

elif SEARCH_MODE == "webapi":
    rule foldseek_webapi:
        # needs internet: runs on the machine where snakemake runs (login node),
        # never submitted to a compute node
        localrule: True
        input:
            COMBINED,
            targets = TARGETS_CSV,
            code = code("02w_foldseek_webapi.py", "lib/foldseek_scoring.py", "lib/rules.py", "lib/lexicon.py",
                        "lib/esmfold_cache.py", "lib/taxonomy.py"),
        output:
            best = BEST_HIT,
            top3 = TOP3,
        params:
            cfg = PARAMS_PARSE,
            aa  = P(PF.PHOLD_AA_FASTA),
            m8  = P(FS3DI / "webapi_hits.m8"),
            all = P(PF.FOLDSEEK_3DI_ALL),
        conda: TOOLS_CONDA
        log: f"{LOGS}/foldseek_webapi.log"
        shell:
            # proteins (<= 400 aa) are folded with ESMFold, searched on the server; scored
            # exactly as the local search
            "$PF_TOOLS python3 $PHAGEFACTOR_HOME/scripts/02w_foldseek_webapi.py --fasta {params.aa} "
            "--targets {input.targets} "
            "--out {params.m8} --best-hit {output.best} --top3 {output.top3} --all-hits {params.all} "
            "> {log} 2>&1"

else:  # none: pharokka + phold evidence only
    rule foldseek_none:
        input:
            targets = TARGETS_CSV,
        output:
            best = BEST_HIT,
            top3 = TOP3,
        conda: TOOLS_CONDA
        log: f"{LOGS}/foldseek_none.log"
        shell:
            "$PF_TOOLS python3 $PHAGEFACTOR_HOME/workflow/scripts/empty_foldseek_tables.py "
            "{output.best} {output.top3} > {log} 2>&1"


# =============================================================================
# STEP 03 — compare / STEP 04 — curate + build output
# =============================================================================
rule compare:
    input:
        COMBINED,
        best = BEST_HIT,
        top3 = TOP3,
        meta = GENE_META,
        code = code("03_compare_annotations.py", "lib/lexicon.py", "lib/utils.py",
                    "lib/rules.py", "lib/taxonomy.py"),
    output:
        COMPARISON,
    params:
        cfg = PARAMS_COMPARE,
    threads: threads_of("compare")
    resources: **res("compare")
    conda: TOOLS_CONDA
    log: f"{LOGS}/compare.log"
    shell:
        "$PF_TOOLS python3 $PHAGEFACTOR_HOME/scripts/03_compare_annotations.py > {log} 2>&1"


rule curate:
    # 04_curate_annotations.py + 05_build_output.py back-to-back
    input:
        COMPARISON,
        meta = GENE_META,
        overrides = [str(OVERRIDES)] if OVERRIDES.is_file() else [],
        precomputed = PRECOMPUTED,
        code = code("04_curate_annotations.py", "05_build_output.py", "lib/rules.py",
                    "lib/lexicon.py", "lib/utils.py", "lib/foldseek_scoring.py"),
    output:
        curated = CURATED,
        final   = FINAL_TABLE,
    params:
        cfg = PARAMS_CURATE,
        # protein mode: 05_build_output.py builds 01_phold/combined/all_prophages_combined.gbk
        # itself (precomputed sub-mode) and would reuse a copy left by an earlier
        # curate run, even after the window/rich-metadata inputs changed
        stale_gbk = P(PF.RAW_GB) if PROTEIN_LIKE else "",
    threads: threads_of("curate")
    resources: **res("curate")
    conda: TOOLS_CONDA
    log: f"{LOGS}/curate.log"
    shell:
        "( if [ -n '{params.stale_gbk}' ]; then rm -f '{params.stale_gbk}'; fi; "
        "  $PF_TOOLS python3 $PHAGEFACTOR_HOME/scripts/04_curate_annotations.py && "
        "  $PF_TOOLS python3 $PHAGEFACTOR_HOME/scripts/05_build_output.py ) > {log} 2>&1"


# =============================================================================
# Phynteny + synteny integration (ON by default)
# =============================================================================
# An env built by --sdm conda has no phynteny models yet: the first job downloads
# them into it (`phagefactor install-envs` does this for the named env).
PHYNTENY_MODELS_SH = (
    "  if ! python3 -c \"import importlib.util as u, pathlib, sys; "
    "s = u.find_spec('phynteny_utils'); d = pathlib.Path(list(s.submodule_search_locations)[0]) / 'models'; "
    "sys.exit(not (d.is_dir() and any(d.iterdir())))\" 2>/dev/null; then "
    "    echo 'phynteny models not found in the env: install_models'; install_models; "
    "  fi; "
) if USE_CONDA else ""

rule phynteny:
    input:
        final = FINAL_TABLE,
        code = code("06_phynteny.py", "07_integrate.py", "lib/synteny_hint.py",
                    "lib/rules.py", "lib/lexicon.py", "lib/utils.py"),
    output:
        done = PHYNTENY_DONE,
    params:
        gbk = UPDATED_GB,
        out = str(PHYNTENY_DIR),
        threshold = SCI.get("phynteny", {}).get("threshold", 0.8),
        cache = PHYNTENY_CACHE,
        work = f"{LOGS}/phynteny_work",
    threads: threads_of("phynteny")
    resources: **res("phynteny")
    conda: PHYNTENY_CONDA
    log: f"{LOGS}/phynteny.log"
    shell:
        # phynteny_transformer writes ./cache/ (the ~2.5 GB ESM2 model, hard-coded
        # cache_dir="cache/") and ./skipped_genomes.txt into its working dir: run it
        # from logs/smk/phynteny_work/ with cache/ linked to ONE shared cache, so the
        # model is downloaded once, not into every run dir. Not from inside
        # 05_phynteny/: -f deletes that dir, the working dir with it.
        # `; touch`, not `&& touch`: set -e is off on the left of && (a failed
        # phynteny would pass as done).
        "( set -e; mkdir -p {params.out} '{params.cache}' {params.work}; "
        "  if [ ! -f {params.gbk} ]; then "
        "    echo '[SKIP] no {params.gbk} (no GenBank could be built): phynteny not run'; exit 0; "
        "  fi; "
        "  cd {params.work}; ln -sfn '{params.cache}' cache; rm -f skipped_genomes.txt; "
        + PHYNTENY_MODELS_SH +
        "  $PF_PHYNTENY python3 $PHAGEFACTOR_HOME/scripts/06_phynteny.py "
        "    --input {params.gbk} --output {params.out} --threshold {params.threshold}; "
        "  if [ -f skipped_genomes.txt ]; then mkdir -p {params.out}/run; mv skipped_genomes.txt {params.out}/run/; fi; "
        "  if [ -f {params.out}/phynteny.tsv ]; then "
        "    $PF_TOOLS python3 $PHAGEFACTOR_HOME/scripts/07_integrate.py "
        "      --final {input.final} --gbk {params.gbk} --phynteny {params.out}/phynteny.tsv "
        "      --out {params.out}/final_annotations_integrated.csv --threshold {params.threshold}; "
        "  else echo '[SKIP] phynteny produced no table'; fi "
        ") > {log} 2>&1; touch {output.done}"


# =============================================================================
# Pangenome: homology-reference set

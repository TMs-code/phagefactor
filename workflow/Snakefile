# --- software environments -----------------------------------------------------
def find_env_runner():
    """`<micromamba|conda> run` prefix. micromamba is looked up as a BINARY: after
    `eval "$(micromamba shell hook)"` it is a bash function, which job shells
    (compute nodes) do not inherit."""
    cand = [setting("micromamba", None, ""), os.environ.get("MAMBA_EXE", ""),
            shutil.which("micromamba") or "",
            str(Path(os.environ.get("MAMBA_ROOT_PREFIX", Path.home() / ".mamba")) / "bin" / "micromamba")]
    for c in cand:
        if c and (os.path.isfile(c) or shutil.which(c)):
            return f"{os.path.abspath(c) if os.path.isfile(c) else shutil.which(c)} run -n"
    conda_bin = os.environ.get("CONDA_EXE") or shutil.which("conda")
    return f"{conda_bin} run --no-capture-output -n" if conda_bin else None


def env_prefix(name, tools, fallback):
    """'' = run in the current env; else '<runner> <env>'. 'auto': the current
    env when it holds the tools (conda install), else the env named `fallback`."""
    if name in (None, "auto"):
        name = "" if all(shutil.which(t) for t in tools) else fallback
    if not name:
        return ""
    if not RUNNER:
        raise WorkflowError(
            f"environment '{name}' requested but no micromamba or conda binary was found "
            "(looked at: workflow.yaml `micromamba`, $MAMBA_EXE, PATH, "
            "$MAMBA_ROOT_PREFIX/bin/micromamba, $CONDA_EXE). Set `micromamba: /path/to/micromamba` "
            "in config/workflow.yaml, or `tools_env: \"\"` to use the active environment.")
    return f"{RUNNER} {name}"


# --sdm conda: Snakemake builds envs/*.yaml and runs each job in its rule's
# `conda:` env, so the commands need no prefix. Otherwise the `conda:`
# directives are ignored and jobs reach the named envs through the prefix.
TOOLS_CONDA    = "../envs/phagefactor.yaml"
PHYNTENY_CONDA = "../envs/phynteny.yaml"
USE_CONDA = "conda" in {getattr(m, "name", str(m)).lower()
                        for m in workflow.deployment_settings.deployment_method}
if USE_CONDA:
    RUNNER = None
    os.environ["PF_TOOLS"] = os.environ["PF_PHYNTENY"] = ""
    TOOLS_LABEL = "(--sdm conda)"
else:
    RUNNER = find_env_runner()
    os.environ["PF_TOOLS"] = env_prefix(setting("tools_env", "MAMBA_ENV", "auto"),
                                        ("pharokka.py", "phold", "foldseek"), "phagefactor")
    os.environ["PF_PHYNTENY"] = (env_prefix(setting("phynteny_env", "PHYNTENY_ENV", "auto"),
                                            ("phynteny_transformer",), "phynteny")
                                 if RUN_PHYNTENY else "")
    TOOLS_LABEL = os.environ["PF_TOOLS"].split()[-1] if os.environ["PF_TOOLS"] else "(current)"


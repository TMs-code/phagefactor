# -----------------------------------------------------------------------------
# Resources (config/workflow.yaml `resources:` + slurm_* settings)
# -----------------------------------------------------------------------------
PARTITION = setting("slurm_partition", "SLURM_PARTITION", "common")
QOS       = setting("slurm_qos", "SLURM_QOS", "fast")
QOS_LONG  = setting("slurm_qos_long", None, "normal")
ACCOUNT   = setting("slurm_account", "SLURM_ACCOUNT", "")
GPU_PART  = setting("slurm_gpu_partition", "SLURM_GPU_PARTITION", "gpu")
GPU_QOS   = setting("slurm_gpu_qos", "SLURM_GPU_QOS", "gpu")
GPU_GRES  = setting("slurm_gpu_gres", None, "gpu:1")
EMAIL     = setting("slurm_email", "SLURM_EMAIL", "")
MAIL_TYPE = setting("slurm_mail_type", "SLURM_MAIL_TYPE", "FAIL")
RES       = config.get("resources", {}) or {}


def res(step, gpu=False, qos=None):
    r = RES.get(step, {})
    out = dict(mem_mb=int(r.get("mem_mb", 16000)), runtime=int(r.get("runtime", 60)),
               cpus_per_task=int(r.get("cpus", 1)),
               slurm_partition=GPU_PART if gpu else PARTITION,
               qos=GPU_QOS if gpu else (qos or QOS))
    if gpu:
        out["gres"] = GPU_GRES
    if r.get("constraint"):          # node features, e.g. avx512
        out["constraint"] = str(r["constraint"])
    if ACCOUNT:
        out["slurm_account"] = ACCOUNT
    # one mail per JOB: none for the per-prophage / per-batch arrays
    if EMAIL and step not in ("pharokka", "phold", "phold_proteins"):
        out["slurm_extra"] = f"--mail-user={EMAIL} --mail-type={MAIL_TYPE}"
    return out


def threads_of(step):
    return int(RES.get(step, {}).get("cpus", 1))



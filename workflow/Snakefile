def code(*names):
    """Script files whose CONTENT a rule depends on: editing one re-runs the rule.
    lib/config.py (paths + defaults read by every script) is always included."""
    return [str(CODE / "scripts" / n) for n in ("lib/config.py", *names)]


# config.yaml sections as rule params: changing a threshold re-runs the rules
# that read it (Snakemake 'params' rerun trigger), and only those.

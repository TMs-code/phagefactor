            "--final {input.final} --id-map {input.id_map} --faa {input.faa} "
            "--out-prefix {params.prefix} > {log} 2>&1"


# =============================================================================
# Interactive report: one self-contained HTML (genome maps, filterable table,
# evidence per gene). Seconds of work: runs where snakemake runs, no SLURM job.
# =============================================================================
rule report:
    localrule: True
    input:
        final = FINAL_TABLE,
        # after phynteny when it runs, so its categories/hints are included
        phynteny = [PHYNTENY_DONE] if RUN_PHYNTENY else [],
        code = code("09_report.py", "lib/report_template.html"),
    output:
        REPORT,
    params:
        integrated = P(Path(PF.PHYNTENY_DIR) / "final_annotations_integrated.csv"),
        gbk = UPDATED_GB,
        title = f"{RUN_DIR.parent.name}/{RUN_DIR.name}",
    conda: TOOLS_CONDA
    log: f"{LOGS}/report.log"
    shell:
        "$PF_TOOLS python3 $PHAGEFACTOR_HOME/scripts/09_report.py --final {input.final} "
        "--integrated '{params.integrated}' --gbk '{params.gbk}' --out {output} "
        "--title '{params.title}' > {log} 2>&1"

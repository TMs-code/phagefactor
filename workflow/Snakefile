)


def _write_if_changed(path, data):
    """Unchanged files keep their mtime, so a re-parse re-runs nothing."""
    path = Path(path)
    if path.is_file() and path.read_bytes() == data:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}")
    tmp.write_bytes(data)
    os.replace(tmp, path)


def code_dir():
    # workflow.basedir is the MAIN Snakefile's dir (the host's, in a module):
    # the dir of THIS Snakefile is current_basedir
    from snakemake.sourcecache import LocalSourceFile
    here = workflow.current_basedir
    if isinstance(here, LocalSourceFile):
        return Path(here.get_path_or_uri(secret_free=True)).resolve().parent
    cache = PROJECT / ".snakemake" / "phagefactor" / "code"
    for f in CODE_FILES:
        _write_if_changed(cache / f, Path(workflow.source_path("../" + f)).read_bytes())
    return cache


CODE = code_dir()


def project_or_default(name):
    f = PROJECT / "config" / name
    return f if f.is_file() else CODE / "config" / name


def _yaml(path):
    try:
        return (yaml.safe_load(Path(path).read_text()) or {}) if Path(path).is_file() else {}
    except (OSError, yaml.YAMLError) as e:
        raise WorkflowError(f"cannot read {path}: {e}")


def _merge(base, over):
    """Recursive merge; null values in `over` leave `base` unchanged."""
    out = dict(base)
    for k, v in (over or {}).items():
        if v is None:
            continue
        out[k] = _merge(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out


USER_SETTINGS = (Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
                 / "phagefactor" / "settings.yaml")
# Snakemake's `config` (--config, a configfile:, or a host workflow's module
# `config:`) may also carry config.yaml sections: they are merged over the
# settings file below. `phynteny` is both: a section (dict) or the on/off switch.
SCIENCE_SECTIONS = ("project", "paths", "databases", "foldseek", "compare", "curate",
                    "phynteny", "precomputed")
_cli = dict(config)
_sci_over = {k: _cli.pop(k) for k in SCIENCE_SECTIONS if isinstance(_cli.get(k), dict)}
# code defaults < user (machine) settings < project < --config
_layered = _merge(_merge(_yaml(CODE / "config" / "workflow.yaml"), _yaml(USER_SETTINGS)),
                  _yaml(PROJECT / "config" / "workflow.yaml"))
config.clear()
config.update(_merge(_layered, _cli))
SCI_FILE = Path(os.environ.get("PHAGEFACTOR_CONFIG") or project_or_default("config.yaml")).resolve()
if _sci_over:
    _sci_base = _yaml(SCI_FILE)
    _sci = _merge(_sci_base, _sci_over)
    if _sci != _sci_base:
        # the scripts read the settings from a file: write the merged one
        SCI_FILE = PROJECT / ".snakemake" / "phagefactor" / "config.yaml"
        _write_if_changed(SCI_FILE, yaml.safe_dump(_sci, sort_keys=False).encode())
os.environ["PHAGEFACTOR_CONFIG"] = str(SCI_FILE)


# -----------------------------------------------------------------------------
# Settings: --config > workflow.yaml > environment variable > default
# -----------------------------------------------------------------------------
def setting(key, env=None, default=None, cast=str):
    v = config.get(key)
    if v is None and env:
        v = os.environ.get(env)
    if v is None or (isinstance(v, str) and v.strip() == "" and default is not None
                     and cast is not str):
        v = default
    if v is None:
        return None
    if cast is bool:
        return v if isinstance(v, bool) else str(v).strip().lower() in ("1", "true", "yes", "on")
    return cast(v)


def _abs(p):
    """Absolute path; a relative one is taken relative to the project dir."""
    p = Path(os.path.expanduser(str(p)))
    return str((p if p.is_absolute() else PROJECT / p).resolve())


os.environ["PHAGEFACTOR_HOME"] = str(CODE)
for _key, _env in (("input_dir", "PHAGEFACTOR_INPUT"), ("run_dir", "PHAGEFACTOR_RUN_DIR")):
    _v = setting(_key, _env)
    if _v:
        os.environ[_env] = _abs(_v)
    # else: config.yaml paths.input_dir / paths.run_dir (relative to the project dir)


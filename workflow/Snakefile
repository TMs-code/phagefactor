# =============================================================================
# phageFACTor — Snakemake workflow
# =============================================================================
# Snakemake decides what has to (re)run from the files themselves:
#   * a new analysis      -> everything runs;
#   * an edited curation rule / lexicon / threshold -> only the steps that use it;
#   * a crashed run       -> relaunch the same command, it resumes.
#
# Launch from a PROJECT dir (holds config/; `phagefactor init <dir>` makes one;
# a git clone of the repo is a project dir too):
#   phagefactor run [-n]               # this machine      (= snakemake --profile profiles/local)
#   phagefactor run --slurm [-n]       # SLURM, login node (= snakemake --profile profiles/slurm)
# Settings, later wins: the defaults shipped with the code (config/), the user's
# machine settings (~/.config/phagefactor/settings.yaml), the project's
# config/workflow.yaml + config/config.yaml, then --config. Guide: docs/configure.md
#
# Design notes (read before editing)
# ----------------------------------
# * The code dir is never written to (it can be a read-only conda install):
#   runs, settings and inputs live in the project dir.
# * Paths come from scripts/lib/config.py — the module every analysis script
#   imports — so the Snakefile and the scripts can never disagree on a path.
# * Tool commands are prefixed with $PF_TOOLS / $PF_PHYNTENY
#   ("micromamba run -n <env>", or empty when the tools are in the current env)
#   and scripts are addressed as $PHAGEFACTOR_HOME/scripts/...: both are
#   expanded by bash, NOT by Snakemake, so moving the code or renaming an env
#   does not change the rule code and does not trigger reruns. Database
#   locations and phold options (GPU/CPU, remote) are passed the same way
#   ($PF_PHAROKKA_DB, $PF_PHOLD_*), so moving the databases re-runs nothing.
# * Step 02 is three rules: targets (cheap) -> search (hours, 256 GB) ->
#   parse (cheap). Scoring code and config.yaml thresholds are inputs/params of
#   `foldseek_parse` only, so editing them never re-runs the search.
# * Snakemake deletes a rule's outputs before re-running it. The ".done"
#   markers are declared as outputs, so a re-run is never skipped by a marker.
# =============================================================================

import os
import sys
import json

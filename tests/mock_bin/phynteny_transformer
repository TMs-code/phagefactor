#!/usr/bin/env python3
"""Mock phynteny_transformer <in.gbk> -o <outdir> [-f] [-m models]."""
import argparse, os, shutil, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _mocklib import rng
from pathlib import Path
from Bio import SeqIO
ap = argparse.ArgumentParser(); ap.add_argument("gbk"); ap.add_argument("-o")
ap.add_argument("-f", action="store_true"); ap.add_argument("-m")
a = ap.parse_args()
if os.environ.get("MOCK_PHYNTENY_FAIL"):
    sys.exit("mock phynteny: failing on request")
out = Path(a.o)
if a.f and out.exists():     # like the real tool: -f deletes the output dir first
    shutil.rmtree(out)
out.mkdir(parents=True, exist_ok=True)
cats = ["head and packaging", "tail", "lysis", "integration and excision", "unknown"]
rows = []
for rec in SeqIO.parse(a.gbk, "genbank"):
    for i, f in enumerate(x for x in rec.features if x.type == "CDS"):
        r = rng("phy", rec.id, i)
        rows.append([f"{rec.id}_{i}", int(f.location.start) + 1, int(f.location.end),
                     "+" if f.location.strand == 1 else "-", "", "unknown function",
                     r.choice(cats), f"{r.random():.3f}", f"{r.random():.3f}", rec.id])
hdr = "ID\tstart\tend\tstrand\tphrog_id\tphrog_category\tphynteny_category\tphynteny_score\tphynteny_confidence\tphage"
for name in ("phynteny.tsv", "phynteny_per_cds_funcions.tsv"):
    with open(out / name, "w") as fh:
        fh.write(hdr + "\n" + "\n".join("\t".join(map(str, r)) for r in rows) + "\n")
shutil.copy(a.gbk, out / "phynteny.gbk")
# like the real tool (v0.1.3): ESM2 cached in ./cache/, skipped list in ./ (cwd)
Path("cache/models--facebook--esm2_t33_650M_UR50D").mkdir(parents=True, exist_ok=True)
Path("cache/models--facebook--esm2_t33_650M_UR50D/weights.bin").write_text("mock")
open("skipped_genomes.txt", "w").close()
print(f"mock phynteny: {len(rows)} CDS")
